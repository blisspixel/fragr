; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="fragr"
run/main_scene="res://scenes/boot_menu.tscn"
boot_splash/bg_color=Color(0.04, 0.04, 0.05, 1)
boot_splash/image="res://assets/ui/boot_splash.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=false
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/macos_native_icon="res://icon.icns"
config/windows_native_icon="res://icon.ico"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194309), Object(InputEventKey,"keycode":4194310), Object(InputEventKey,"keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
