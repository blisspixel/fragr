msgid "LOADING_CONTROLS_KEYS"
msgstr "{move_forward} {move_left} {move_back} {move_right} or arrows to move        {turn_left} {turn_right} or mouse to turn\n{fire} or mouse to fire        {interact} to use        {jump} to jump        {strafe} + arrows to strafe\n{look_up} {look_down} to look        Wheel or 1-5 for weapons        {pause} for the menu        Tilde for the console"

msgid "LOADING_CONTROLS_PAD"
msgstr "Left stick moves        Right stick looks        {fire} fires        {interact} uses        {jump} jumps\n{weapon_prev} {weapon_next} change weapon        {speak} taunts        {pause} for the menu"

