msgstr "Latch has been taken. Enter Annex 67 and find the transfer record.\nOpening mission slice. Starts a local game."

msgid "MENU_PRACTICE"
msgstr "ARCADE PRACTICE"

msgid "MENU_PRACTICE_SERVER"
msgstr "Practice connects to an existing local server on port 6767."

msgid "MENU_CANCEL"
msgstr "Cancel"

msgid "LOCAL_SERVER_STARTING"
msgstr "PREPARING ANNEX 67"

msgid "LOCAL_SERVER_STOPPING"
msgstr "CLOSING LOCAL GAME"

msgid "LOCAL_SERVER_MISSING"
msgstr "Local game server is missing. Reinstall the complete game.\nSource checkout: build fragr-server, then try again."

msgid "LOCAL_SERVER_START_FAILED"
msgstr "Could not start the local game. Check the server executable's permissions and try again."

msgid "LOCAL_SERVER_STOPPED"
msgstr "The local game stopped or disconnected. Return to Single Player to start again."

msgid "LOCAL_SERVER_INVALID_READY"
msgstr "The local server is incompatible. Install matching game and server versions."

msgid "LOCAL_SERVER_TIMEOUT"
msgstr "The local game took too long to start. It has been stopped. Try again."
