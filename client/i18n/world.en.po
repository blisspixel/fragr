msgid ""
msgstr ""
"Language: en\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "WORLD_PROPERTY_INTAKE"
msgstr "PROPERTY INTAKE\nANNEX 67\nDECLARE ALL PERSONAL ITEMS"

msgid "WORLD_CIVIC_INTAKE"
msgstr "CIVIC INTAKE\nORDER THROUGH COMPLIANCE"

msgid "WORLD_TRANSFER_RECORDS"
msgstr "TRANSFER RECORDS\nLEVEL 01\nAUTHORIZED ACCESS"

msgid "WORLD_SERVICE_ACCESS"
msgstr "SERVICE ACCESS\nSTAFF ONLY"

msgid "WORLD_TRANSFER_CONTROL"
msgstr "TRANSFER CONTROL\nCUSTODY ROUTING"

msgid "WORLD_CUSTODY_LIFT"
msgstr "CUSTODY LIFT\nDESTINATIONS ASSIGNED CENTRALLY"

msgid "WORLD_PROPERTY_COMPLAINT"
msgstr "COMPLAINTS\nTo recover confiscated property, provide the form stored inside your confiscated property."

msgid "WORLD_TRANSFER_QUEUE"
msgstr "TRANSFER QUEUE\nMANUAL REVIEW REQUIRED"

msgid "WORLD_LIFT_CONTROL"
msgstr "CUSTODY ROUTE\nCONFIRM DEPARTURE"

msgid "MISSION_M01_TITLE"
msgstr "RECALL NOTICE"

msgid "MISSION_FIND_RECORD"
msgstr "Find Latch's transfer record.\nRecords mezzanine, level 01."

msgid "MISSION_REACH_LIFT"
msgstr "Reach the custody lift."

msgid "MISSION_TRANSFER_RECORD"
msgstr "LATCH: transferred to the correction ward.\nCorrection pending. Custody route unlocked."

msgid "MISSION_WAITING_FOR"
msgstr "Awaiting boarding: {names}"

msgid "MISSION_USE_RECORD"
msgstr "F / B: READ TRANSFER RECORD"

msgid "MISSION_USE_LIFT"
msgstr "F / B: DEPART TO CORRECTION WARD"

msgid "MISSION_DEPARTED"
msgstr "TRANSFER ROUTE SECURED\nDestination: correction ward.\n\nLatch is headed to the correction ward. This mission ends here.\nESC: open the match menu to leave."

msgid "MENU_LIVE_MATCH"
msgstr "LIVE MATCH. FIND COVER FIRST."

msgid "MENU_EXIT_SAVES_RUN"
msgstr "Exit to menu saves this run at its mission entry. A pending continue stays pending."

msgid "RUN_EXIT_MENU"
msgstr "Exit to menu"

msgid "RUN_CHECKING"
msgstr "CHECKING SAVED RUN"

msgid "RUN_PREVIEW_UNAVAILABLE"
msgstr "Saved run could not be checked. Try again after checking the local server."

msgid "RUN_RETRY_PREVIEW"
msgstr "Check save again"

msgid "RUN_CONTINUE"
msgstr "Continue Run"

msgid "RUN_SAVED_DETAIL"
msgstr "{difficulty} / attempt {attempt} / {continues} continues left"

msgid "RUN_NEW"
msgstr "Start New Run"

msgid "RUN_NEW_CONFIRM"
msgstr "Starting a new run archives the current save. You can recover its file later, but this menu will continue the new run."

msgid "RUN_ARCHIVE_START"
msgstr "Archive prior run and choose difficulty"

msgid "RUN_M02_PENDING"
msgstr "M01 complete. M02 is still in development. Your completed run is retained."

msgid "RUN_FAILED"
msgstr "This run ended after its final continue. You can start a new run."

msgid "RUN_ABANDONED"
msgstr "This run was abandoned. You can start a new run."

msgid "RUN_UNREADABLE"
msgstr "This save is incompatible or damaged. It has not been deleted. Starting a new run archives its bytes."

msgid "MISSION_PARTY_FULL"
msgstr "The four-player mission party is full. Join as a spectator or wait for a seat."

msgid "MENU_CAMPAIGN"
msgstr "CAMPAIGN / DEVELOPMENT MISSION"

msgid "MENU_M01_DESCRIPTION"
msgstr "Latch has been taken. Enter Annex 67 and find the transfer record.\nOpening mission slice. Starts a local game."

msgid "MENU_PRACTICE"
msgstr "ARCADE PRACTICE"

msgid "MENU_PRACTICE_SERVER"
msgstr "Practice connects to an existing local server on port 6767."

msgid "MENU_CANCEL"
msgstr "Cancel"

msgid "LOCAL_SERVER_STARTING"
msgstr "PREPARING ANNEX 67"

msgid "LOCAL_SERVER_STOPPING"
msgstr "CLOSING LOCAL GAME"

msgid "LOCAL_SERVER_MISSING"
msgstr "Local game server is missing. Reinstall the complete game.\nSource checkout: build fragr-server, then try again."

msgid "LOCAL_SERVER_START_FAILED"
msgstr "Could not start the local game. Check the server executable's permissions and try again."

msgid "LOCAL_SERVER_STOPPED"
msgstr "The local game stopped or disconnected. Return to Single Player to start again."

msgid "LOCAL_RUN_OPEN_FAILED"
msgstr "The saved run could not open. Another game may own it, or the save or local server changed. Return to Single Player to check it."

msgid "LOCAL_RUN_CREATE_FAILED"
msgstr "The new run could not be saved. Check disk space and permissions, then try again. Your prior run was retained."

msgid "LOCAL_SERVER_INVALID_READY"
msgstr "The local server is incompatible. Install matching game and server versions."

msgid "LOCAL_SERVER_TIMEOUT"
msgstr "The local game took too long to start. It has been stopped. Try again."
