msgid "STORY_M11_ARRIVAL_TENDER"
msgstr "The boarding tube opens onto a Union custody tender. The armory is close; the bridge is at the far end of the spine."

msgid "STORY_M11_ARRIVAL_TERN"
msgstr "Tern: \"My crew have a card game to finish. Try to leave us a ship.\""

